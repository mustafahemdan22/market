# ==============================================================================
# Grocery Marketplace — Environment Configuration Contract
#
# THIS FILE CONTAINS PLACEHOLDERS ONLY. Never commit real keys or secrets.
#
# Configuration Surfaces:
#   1. PUBLIC MOBILE   (apps/mobile/.env.local) -> EXPO_PUBLIC_*   [PUBLIC]
#   2. PUBLIC ADMIN    (apps/admin/.env.local)  -> NEXT_PUBLIC_*   [PUBLIC]
#   3. CONVEX BACKEND  (Convex Dashboard)       -> Server Secrets  [SERVER-ONLY]
#   4. LOCAL CLI / DEV (root .env.local)        -> CONVEX_*        (for Convex CLI)
#
# Security Rules:
# - Variables prefixed with EXPO_PUBLIC_* or NEXT_PUBLIC_* are inlined into client
#   bundles and are public by design. Never put secrets or allowlists in them.
# - Server secrets, Cloudinary secrets, and PANDAMA_ADMIN_SUBJECTS belong ONLY in
#   the Convex backend runtime. Never include them in mobile or admin env files.
# ==============================================================================


# ==============================================================================
# 1. MOBILE CLIENT — apps/mobile/.env.local
#    Use apps/mobile/.env.local (do NOT place these in the repository root).
#    Contains ONLY public client values bundled into the Expo mobile application.
#    Never include server secrets or PANDAMA_ADMIN_SUBJECTS in mobile env files.
# ==============================================================================

# [PUBLIC] Clerk Publishable Key (safe to expose by design; starts with pk_).
# Where: Clerk Dashboard -> API Keys -> Publishable key
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_replace_me

# [PUBLIC] Convex Client Deployment URL.
# NOTE: This is a public deployment URL (e.g., https://<deployment>.convex.cloud),
#       NOT a secret. The mobile app uses this URL to connect to Convex.
# Where: Convex Dashboard -> Settings -> URL & Deploy Key, or printed by `npx convex dev`
EXPO_PUBLIC_CONVEX_URL=https://placeholder.convex.cloud

# Cloudinary cloud name, used by the mobile app to DERIVE product image URLs.
# PUBLIC: a cloud name is an identifier, not a credential. Convex stores only
# the image public id; the delivery URL is built in the client. The matching
# API SECRET is never exposed to any client and lives only in the Convex runtime.
# Where: Cloudinary Console -> settings
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=placeholder_cloud_name


# ==============================================================================
# 2. ADMIN DASHBOARD — apps/admin/.env.local
#    Contains public client values for the Next.js admin dashboard.
#    Never place Cloudinary API secrets or PANDAMA_ADMIN_SUBJECTS here.
# ==============================================================================

# [PUBLIC] Clerk Publishable Key for the Admin Web App.
# Where: Clerk Dashboard -> API Keys -> Publishable key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_replace_me

# [PUBLIC] Convex Client Deployment URL for the Admin Web App.
# NOTE: This is a public deployment URL, NOT a secret. Both admin and mobile
#       connect to the same Convex deployment; functions are guarded server-side.
NEXT_PUBLIC_CONVEX_URL=https://placeholder.convex.cloud

# [SERVER-ONLY] (OPTIONAL) Clerk Secret Key for Admin Node.js Backend API calls.
# Add ONLY if apps/admin executes server-side Node.js routes calling the Clerk Backend API.
# Never expose to the browser bundle or use a NEXT_PUBLIC_ prefix.
# CLERK_SECRET_KEY=sk_test_placeholder_replace_me


# ==============================================================================
# 3. REPO / CLI — .env.local at repository root (git-ignored)
#    Read locally by the Convex CLI to connect to your development deployment.
# ==============================================================================

# Convex deployment identifier (used by `npx convex dev` / `npx convex deploy`).
# Where: Generated by `npx convex dev` or found in Convex Dashboard -> Settings.
CONVEX_DEPLOYMENT=placeholder_deployment_name


# ==============================================================================
# 4. CONVEX RUNTIME — Convex Dashboard -> Settings -> Environment Variables
#    Set with: npx convex env set <NAME> <VALUE> or in the Convex Dashboard.
#    [SERVER-ONLY]: These execute strictly in Convex and NEVER reach clients.
# ==============================================================================

# --- Required for Clerk + Convex Authentication ------------------------------

# [SERVER-ONLY] Clerk JWT Issuer Domain.
# Where: Clerk Dashboard -> Configure -> JWT Templates -> Convex -> Issuer URL
# NOTE: Convex authenticates incoming Clerk JWTs against Clerk's public JWKS.
#       CLERK_SECRET_KEY is NOT required for basic Clerk/Convex JWT authentication.
CLERK_JWT_ISSUER_DOMAIN=https://placeholder.clerk.accounts.dev

# [SERVER-ONLY] Admin Allowlist of Clerk User IDs.
# Where: Set in Convex Dashboard -> Settings -> Environment Variables
# IMPORTANT: Must contain Clerk User IDs (e.g. user_2xxx,user_3yyy), NOT email addresses.
# Read server-side by requireAdmin(). Never expose to mobile or admin client bundles.
PANDAMA_ADMIN_SUBJECTS=user_placeholder_replace_me

# --- Optional Backend Clerk Integrations -------------------------------------

# [SERVER-ONLY] Clerk Backend Secret Key.
# Add ONLY if the backend actually calls the Clerk Backend API (e.g. admin actions).
# It is NOT needed for basic Clerk/Convex JWT authentication.
# CLERK_SECRET_KEY=sk_test_placeholder_replace_me

# [SERVER-ONLY] Clerk Webhook Signing Secret.
# Where: Clerk Dashboard -> Webhooks -> Signing Secret (Svix)
# Add ONLY if handling Clerk webhook events in Convex http.ts.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_placeholder_replace_me

# --- Cloudinary Media Signing (Server-Only) -----------------------------------
# Cloudinary credentials belong ONLY in the Convex backend environment.
# NEVER place Cloudinary API secrets in mobile or admin client environments.

# [SERVER-ONLY] Cloudinary cloud name.
CLOUDINARY_CLOUD_NAME=placeholder_cloud_name

# [SERVER-ONLY] Cloudinary API key.
CLOUDINARY_API_KEY=placeholder_api_key_number

# [SERVER-ONLY] Cloudinary API secret. Used strictly inside the Convex signing action.
CLOUDINARY_API_SECRET=placeholder_replace_me

# [SERVER-ONLY] Server-enforced folder prefix for uploaded media.
CLOUDINARY_UPLOAD_FOLDER=grocery/products

# --- Store Configuration ------------------------------------------------------
# [SERVER-ONLY] Default currency code (ISO 4217). Prices are stored in minor units.
DEFAULT_CURRENCY=EGP