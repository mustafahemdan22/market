# ==============================================================================
# Grocery Marketplace — Environment Configuration Contract
#
# THIS FILE CONTAINS PLACEHOLDERS ONLY. Never commit a real key or secret.
#
# Four configuration surfaces exist. A value must be set in the ONE correct place:
#
#   1. PUBLIC MOBILE  apps/mobile/.env        -> EXPO_PUBLIC_*   (bundled into client)
#   2. REPO / CLI     .env.local at root     -> CONVEX_*        (read by `npx convex dev`)
#   3. CONVEX RUNTIME Convex Dashboard        -> server secrets  (never leaves backend)
#   4. ADMIN (absent) apps/admin             -> NEXT_PUBLIC_*   (not built yet)
#
# Rule: EXPO_PUBLIC_* and NEXT_PUBLIC_* FORCE inclusion in a client bundle.
# Never give a secret one of those prefixes.
# ==============================================================================


# ==============================================================================
# 1. PUBLIC MOBILE — apps/mobile/.env
#    Bundled into the Expo client. Public values only, no secrets.
# ==============================================================================

# Clerk Publishable Key (starts with pk_ — safe to expose by design).
# Where: Clerk Dashboard -> API Keys -> Publishable key
# Local dev normally uses the ...pk_test_... variant.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_replace_me

# Convex client deployment URL.
# Where: Convex Dashboard -> Settings -> URL & Deploy Key, or the URL printed
#        by `npx convex dev`. Must start with https://
EXPO_PUBLIC_CONVEX_URL=https://placeholder.convex.cloud

# Clerk publishable key for the ADMIN DASHBOARD (apps/admin).
# Same Clerk publishable key as the mobile app; only the prefix differs because
# Next.js inlines NEXT_PUBLIC_* rather than EXPO_PUBLIC_*.
# Where: Clerk Dashboard -> API Keys -> Publishable key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_replace_me

# Convex client deployment URL for the ADMIN DASHBOARD.
# Same URL as EXPO_PUBLIC_CONVEX_URL. The admin app and the mobile app talk to
# the same deployment; every function is independently guarded server-side.
NEXT_PUBLIC_CONVEX_URL=https://placeholder.convex.cloud


# ==============================================================================
# 2. REPO / CLI — .env.local at repository root (NOT committed)
#    Read by the Convex CLI to select a deployment. No secrets here.
#    Copy .env.example to .env.local and fill locally.
# ==============================================================================

# Convex deployment name (used by `npx convex dev` / `npx convex deploy`).
# Where: Convex Dashboard -> Settings -> Deployment name.
CONVEX_DEPLOYMENT=placeholder_deployment_name


# ==============================================================================
# 3. CONVEX RUNTIME — Convex Dashboard -> Settings -> Environment Variables
#    Server-only. These values are never sent to the mobile app.
#    Set with: npx convex env set <NAME> <VALUE>  (do NOT commit them here)
# ==============================================================================

# --- Clerk ---------------------------------------------------------------
# Clerk Frontend API URL / JWT issuer domain.
# Where: Clerk Dashboard -> Configure -> JWT Templates -> Convex
#        (the same host appears as the "Issuer" on that page)
# NOTE: Convex's guide calls this CLERK_JWT_ISSUER_DOMAIN. The two names refer
#       to the same URL. CLERK_FRONTEND_API_URL is used here.
CLERK_FRONTEND_API_URL=https://placeholder.clerk.accounts.dev

# Clerk backend API key. Used only for user administration and webhooks.
# NEVER place in an EXPO_PUBLIC_* variable or an apps/mobile/.env file.
# Where: Clerk Dashboard -> API Keys -> Secret key
CLERK_SECRET_KEY=sk_test_placeholder_replace_me

# Verifies Clerk webhook signatures (Svix scheme).
# Where: Clerk Dashboard -> Webhooks -> Signing Secret
CLERK_WEBHOOK_SIGNING_SECRET=whsec_placeholder_replace_me

# --- Cloudinary (signed upload flow) -------------------------------------
# Cloudinary is configured in the Convex runtime ONLY. The mobile app never
# holds these values; it receives short-lived signed upload parameters.
CLOUDINARY_CLOUD_NAME=placeholder_cloud_name
CLOUDINARY_API_KEY=placeholder_api_key_number
CLOUDINARY_API_SECRET=placeholder_replace_me

# Server-chosen folder prefix for product images. Signed into every upload
# request so a client cannot write outside this folder.
CLOUDINARY_UPLOAD_FOLDER=grocery/products

# --- Authorization --------------------------------------------------------
# Comma-separated allowlist of Clerk user IDs authorized as administrators.
# Read server-side by requireAdmin(). Never exposed to any client.
# Where: Convex Dashboard -> Environment Variables
PANDAMA_ADMIN_SUBJECTS=user_placeholder_replace_me

# --- Store configuration --------------------------------------------------
# ISO-4217 code. Integer minor units are used everywhere (EGP = 2 decimals).
DEFAULT_CURRENCY=EGP


# ==============================================================================
# NOTES
# ==============================================================================
# * .gitignore already excludes .env, .env.local, .env.*.local at any depth and
#   re-includes .env.example.
# * A CI job greps the built mobile bundle for CLERK_SECRET_KEY and
#   CLOUDINARY_API_SECRET; a hit fails the build.
# * Nothing in this file should ever be replaced with a working credential.
# ==============================================================================