# ==============================================================================
# Grocery Marketplace Environment Configuration Contract
#
# IMPORTANT:
# - NEVER commit real secrets or production keys to source control.
# - Copy this template to .env or .env.local for development.
# ==============================================================================

# ------------------------------------------------------------------------------
# Mobile Client (apps/mobile)
# Variables prefixed with EXPO_PUBLIC_ are bundled into client code.
# NEVER put secret keys in EXPO_PUBLIC_ variables.
# ------------------------------------------------------------------------------
# Clerk Publishable Key (from Clerk Dashboard -> API Keys)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_aGFybWxlc3MtYmVlLTI2NjcuY2xlcmsuYWNjb3VudHMuZGV2JA

# Convex Deployment URL (from Convex Dashboard -> Settings -> URL & Deploy Key)
EXPO_PUBLIC_CONVEX_URL=https://impartial-curlew-234.convex.cloud

# ------------------------------------------------------------------------------
# Backend Runtime (packages/convex)
# Set in the Convex Dashboard -> Settings -> Environment Variables.
# ------------------------------------------------------------------------------
# Convex Deployment identifier
CONVEX_DEPLOYMENT=https://impartial-curlew-234.convex.site

# Clerk JWT Issuer Domain (from Clerk Dashboard -> Configure -> JWT Templates -> Convex -> Issuer)
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-subdomain.clerk.accounts.dev

# Clerk Secret Key (for server-side Admin API & webhooks - NEVER exposed to mobile)
CLERK_SECRET_KEY=sk_test_placeholder_replace_me

# Clerk Webhook Secret (from Clerk Dashboard -> Webhooks -> Signing Secret)
CLERK_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Store currency configuration (defaults to EGP if unset)
DEFAULT_CURRENCY=EGP
