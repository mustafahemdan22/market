{
  "name": "grocery-marketplace",
  "version": "0.0.0",
  "private": true,
  "description": "Premium grocery marketplace — Expo mobile app, Convex backend, Next.js admin",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "mobile": "npm run start --workspace @grocery/mobile",
    "shared": "npm run build --workspace @grocery/shared"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "eslint": "^10.12.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.71.1",
    "globals": "^16.0.0",
    "prettier": "^3.9.9",
    "vitest": "^5.0.3",
    "@types/node": "^26.6.5"
  }
}
